 "comments": [
  {
   "address": 2282,
   "type": "line",
   "text": "the play interrupt continues here (target of the JMP at $09CC)"
  },
  {
   "address": 2503,
   "type": "line",
   "text": "hardware IRQ vector in play ($FFFE): saves A, Y and X and jumps to the band handler"
  },
  {
   "address": 2902,
   "type": "line",
   "text": "NMI vector in play points at this RTI, so RESTORE does nothing"
  },
  {
   "address": 2903,
   "type": "line",
   "text": "installs the next raster interrupt: X/Y = handler address into $FFFE/$FFFF, A = raster line into $D012"
  },
  {
   "address": 3676,
   "type": "line",
   "text": "main loop of play"
  },
  {
   "address": 3679,
   "type": "line",
   "text": "waits until bit 7 of $0400 is set (the frame flag), then runs the pass"
  },
  {
   "address": 3695,
   "type": "line",
   "text": "clears the frame flag and loops"
  },
  {
   "address": 3908,
   "type": "line",
   "text": "sets $D016 for play"
  },
  {
   "address": 5892,
   "type": "line",
   "text": "reads the SID's paddle X register $D419 (1351 mouse in proportional mode)"
  },
  {
   "address": 5912,
   "type": "line",
   "text": "reads the paddle Y register $D41A"
  },
  {
   "address": 5961,
   "type": "line",
   "text": "an RTS no path reaches, after the JMP above"
  },
  {
   "address": 12517,
   "type": "line",
   "text": "writes to SID voice 1 control $D404 (sound driver region $30E5-$3156)"
  },
  {
   "address": 52256,
   "type": "line",
   "text": "jump table of the resident loader (nine JMPs)"
  },
  {
   "address": 52283,
   "type": "line",
   "text": "reads an eight-byte header at $9000 into zero page $02-$0D"
  },
  {
   "address": 52622,
   "type": "line",
   "text": "the same with the code from $0700,X, its top three bits forced to 7"
  },
  {
   "address": 52630,
   "type": "line",
   "text": "loads the file whose code byte is $0400,X: low five bits the second letter of its name, top three bits its kind and disk side"
  },
  {
   "address": 52672,
   "type": "line",
   "text": "the file is on another disk side than $CB60 says is in the drive: the game's prompt at $5009, then try again"
  },
  {
   "address": 52694,
   "type": "line",
   "text": "the load failed: the game's handler at $5006, then try again"
  },
  {
   "address": 52702,
   "type": "line",
   "text": "the first letters of the file names by kind: F T X M P I C S"
  },
  {
   "address": 52710,
   "type": "line",
   "text": "the disk side each kind is on: F 2, T 3, X 4, M 5 (the four level sides), P, I and C 0 (disk 1), S $FF (any: every level side carries SA-SI)"
  },
  {
   "address": 54581,
   "type": "line",
   "text": "briefing and end-of-level messages as screen codes, with XX where numbers go; a copy filled in for the current level lies at $5444"
  }
 ]
